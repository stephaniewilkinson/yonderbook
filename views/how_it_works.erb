<% content_for :title, "How It Works" %>
<% content_for :description, "Step-by-step guide to using Yonderbook. Connect your Goodreads account, select your library, and find free ebooks and audiobooks from your want-to-read list." %>

<% # HowTo Schema for this page. Steps come from SiteCopy::STEPS so the markup
   # Google can lift into a rich result stays in the order the app actually
   # walks people through. It used to put "select your library" before
   # "choose a shelf" and point two steps at the same URL. %>
<script type="application/ld+json">
<%= SiteCopy.how_to_json_ld %>
</script>

<div class="max-w-4xl mx-auto">
  <h1 class="font-display text-4xl font-medium tracking-tight text-mauve-950 mb-4">How Yonderbook Works</h1>
  <p class="text-xl text-mauve-700 mb-12">
    Turn your Goodreads want-to-read list into free books in <%= SiteCopy::STEPS.size %> steps. No account needed.
  </p>

  <!-- Steps. Rendered from SiteCopy::STEPS, the same source as the HowTo
       schema above, so the page and the structured data cannot disagree about
       what order things happen in. -->
  <div class="space-y-12">
    <% SiteCopy::STEPS.each_with_index do |step, i| %>
      <div class="flex gap-6">
        <div class="flex-shrink-0">
          <div class="w-12 h-12 bg-mauve-950 text-white rounded-full flex items-center justify-center font-display font-medium text-xl"><%= i + 1 %></div>
        </div>
        <div class="flex-1">
          <h2 class="text-2xl font-display font-medium text-mauve-950 mb-3"><%= step[:name] %></h2>
          <p class="text-mauve-700 leading-relaxed mb-4"><%= step[:text] %></p>
          <% if i.zero? %>
            <%= partial 'two_click_explainer' %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-12 rounded-xl bg-mauve-950/[.025] p-6">
    <h2 class="text-lg font-semibold text-mauve-950 mb-2">Do I need an account?</h2>
    <p class="text-mauve-700 leading-relaxed">
      <%= SiteCopy::FAQ.find { |entry| entry[:question] == 'Do I need a Yonderbook account?' }[:answer] %>
    </p>
  </div>

  <!-- What You Get Section -->
  <div class="mt-16 border-t border-mauve-950/10 pt-12">
    <h2 class="font-display text-2xl font-medium text-mauve-950 mb-8">What else can you do with Yonderbook?</h2>

    <div class="grid md:grid-cols-2 gap-6">
      <div class="rounded-xl bg-mauve-950/[.025] p-6">
        <h3 class="text-lg font-semibold text-mauve-950 mb-3">Analyze your reading</h3>
        <p class="text-mauve-700">
          See statistics about your reading habits: author gender breakdown, publication year distribution, your rating patterns, and more. Discover if you're reading as diversely as you think.
        </p>
      </div>

      <div class="rounded-xl bg-mauve-950/[.025] p-6">
        <h3 class="text-lg font-semibold text-mauve-950 mb-3">Search any shelf</h3>
        <p class="text-mauve-700">
          Not just want-to-read—search any Goodreads shelf including your "read" shelf to find books you might want to re-read, or custom shelves you've created.
        </p>
      </div>

      <div class="rounded-xl bg-mauve-950/[.025] p-6">
        <h3 class="text-lg font-semibold text-mauve-950 mb-3">Multiple libraries</h3>
        <p class="text-mauve-700">
          Have library cards for multiple systems? Search different libraries to maximize your chances of finding available copies.
        </p>
      </div>

      <div class="rounded-xl bg-mauve-950/[.025] p-6">
        <h3 class="text-lg font-semibold text-mauve-950 mb-3">BookMooch integration</h3>
        <p class="text-mauve-700">
          Automatically add books from your Goodreads list to your BookMooch wishlist. Get notified when books you want become available for trading.
        </p>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="mt-12 rounded-xl bg-mauve-950 p-8 text-center">
    <h2 class="font-display text-2xl font-medium text-white mb-4">Ready to find your next free book?</h2>
    <p class="text-mauve-300 mb-6">Connect Goodreads and search your library. No account needed.</p>
    <a href="/connect" class="inline-flex items-center px-6 py-3 bg-white text-mauve-950 font-medium rounded-full hover:bg-mauve-100 transition-colors">
      Find your books
    </a>
  </div>
</div>
