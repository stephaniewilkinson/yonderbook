<% # Shown only to a visitor who got here without an account, after they can
   # already see their results. The order matters: the product has to have
   # worked before it asks for anything.
   #
   # @anonymous_search is set by lib/search_routes.rb on the anonymous
   # availability route and nowhere else, so the authenticated flow never
   # renders any of this. %>
<div class="mt-12 grid gap-6 md:grid-cols-2 max-w-5xl mx-auto">
  <div id="save-results-card" class="glass-panel rounded-2xl p-6 border border-white/40">
    <h3 class="font-display text-xl font-medium text-mauve-950 mb-2">Want to keep these results?</h3>
    <p class="text-mauve-700 text-sm leading-relaxed mb-5">
      Your search lives in this browser session and goes away when it ends. An account keeps your
      Goodreads connection so you don't reconnect each visit, and unlocks BookMooch trading for the
      books your library doesn't have.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="/sign-up" class="inline-flex items-center px-5 py-2.5 bg-mauve-950 text-white text-sm font-medium rounded-full hover:bg-mauve-900 transition-colors">
        Create a free account
      </a>
      <button type="button" onclick="document.getElementById('save-results-card').remove()"
              class="inline-flex items-center px-5 py-2.5 bg-mauve-950/10 text-mauve-950 text-sm font-medium rounded-full hover:bg-mauve-950/20 transition-colors">
        Maybe later
      </button>
    </div>
  </div>

  <div class="glass-panel rounded-2xl p-6 border border-white/40">
    <h3 class="font-display text-xl font-medium text-mauve-950 mb-2">See your reading patterns</h3>
    <p class="text-mauve-700 text-sm leading-relaxed mb-5">
      The same shelf you just searched can tell you how your reading breaks down by author gender,
      publication year and your own ratings.
    </p>
    <div class="flex items-end gap-1.5 h-16 mb-5" aria-hidden="true">
      <% [40, 65, 30, 80, 55, 70, 45].each do |height| %>
        <div class="flex-1 rounded-t bg-gradient-to-t from-indigo-300 to-violet-400" style="height: <%= height %>%"></div>
      <% end %>
    </div>
    <a href="/sign-up" class="inline-flex items-center px-5 py-2.5 bg-mauve-950/10 text-mauve-950 text-sm font-medium rounded-full hover:bg-mauve-950/20 transition-colors">
      Unlock reading analytics
    </a>
  </div>
</div>

<% # Email capture. Renders only when KIT_FORM_ACTION_URL is configured, so a
   # deploy without it simply has no form rather than a broken one. The submit
   # is a fetch() straight to Kit -- no vendor JS, and the visitor keeps their
   # results on screen. %>
<% if (kit_action = ENV.fetch('KIT_FORM_ACTION_URL', nil)) && !kit_action.empty? %>
  <div class="mt-6 max-w-5xl mx-auto">
    <div class="glass-panel rounded-2xl p-6 border border-white/40">
      <h3 class="font-display text-xl font-medium text-mauve-950 mb-2">Get notified when your books become available</h3>
      <p class="text-mauve-700 text-sm leading-relaxed mb-5">
        Waiting lists move. Leave your email and hear when the books you couldn't borrow today open up.
      </p>
      <form id="kit-notify-form" class="flex flex-col sm:flex-row gap-3" action="<%= kit_action %>" method="post">
        <label class="sr-only" for="kit-email">Email address</label>
        <input id="kit-email" name="email_address" type="email" required placeholder="you@example.com"
               class="flex-1 px-4 py-2.5 rounded-full border border-mauve-950/20 bg-white/70 text-mauve-950 placeholder-mauve-400 focus:outline-none focus:ring-2 focus:ring-indigo-300">
        <button type="submit" class="px-5 py-2.5 bg-mauve-950 text-white text-sm font-medium rounded-full hover:bg-mauve-900 transition-colors">
          Notify me
        </button>
      </form>
      <p id="kit-notify-status" class="mt-3 text-sm text-mauve-700 hidden" role="status" aria-live="polite"></p>
    </div>
  </div>

  <script>
    (function () {
      var form = document.getElementById('kit-notify-form');
      var status = document.getElementById('kit-notify-status');
      if (!form) return;

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var button = form.querySelector('button[type="submit"]');
        button.disabled = true;
        status.classList.remove('hidden');
        status.textContent = 'Subscribing…';

        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {'Accept': 'application/json'}
        }).then(function (response) {
          if (!response.ok) throw new Error('subscribe failed');
          form.classList.add('hidden');
          status.textContent = 'Subscribed. We will email you when these open up.';
        }).catch(function () {
          button.disabled = false;
          status.textContent = 'That did not go through. Please try again in a moment.';
        });
      });
    })();
  </script>
<% end %>
