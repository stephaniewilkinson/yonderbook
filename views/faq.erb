<% content_for :title, "FAQ" %>
<% content_for :description, "Frequently asked questions about Yonderbook. Learn how to connect Goodreads, find free library books via Libby/OverDrive, and use BookMooch for book trading." %>

<% # Both renderings below read from SiteCopy::FAQ, so the structured data and
   # the visible page cannot drift apart. Google treats JSON-LD that does not
   # match visible content as a markup violation, and every answer here used to
   # be typed out twice. %>
<script type="application/ld+json">
<%= SiteCopy.faq_json_ld %>
</script>

<div class="max-w-4xl mx-auto">
  <h1 class="font-display text-4xl font-medium tracking-tight text-mauve-950 mb-4">Frequently Asked Questions</h1>
  <p class="text-xl text-mauve-700 mb-12">
    Everything you need to know about using Yonderbook to find free books
  </p>

  <div class="divide-y divide-mauve-950/10">
    <% SiteCopy::FAQ.each do |entry| %>
      <details class="group py-6">
        <summary class="flex cursor-pointer items-center justify-between text-xl font-semibold text-mauve-950">
          <%= entry[:question] %>
          <svg class="ml-4 h-5 w-5 flex-shrink-0 text-mauve-500 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6"></path></svg>
        </summary>
        <p class="mt-4 text-mauve-700 leading-relaxed">
          <%= entry[:answer] %>
        </p>
      </details>
    <% end %>
  </div>

  <!-- CTA -->
  <div class="mt-12 rounded-xl bg-mauve-950 p-8 text-center">
    <h2 class="font-display text-2xl font-medium text-white mb-4">Still have questions?</h2>
    <p class="text-mauve-300 mb-6">Use the chat widget in the corner, or just start searching — you don't need an account.</p>
    <a href="/connect" class="inline-flex items-center px-6 py-3 bg-white text-mauve-950 font-medium rounded-full hover:bg-mauve-100 transition-colors">
      Find your books
    </a>
  </div>
</div>
