<% content_for :title, "Delete Your Account" %>
<% content_for :description, "Delete your Yonderbook account and everything stored with it." %>
<% content_for :robots, 'noindex' %>

<div class="max-w-md mx-auto">
  <div class="text-center mb-8">
    <h1 class="font-display text-3xl sm:text-4xl font-medium tracking-tight text-mauve-950 mb-3">
      Delete Your Account
    </h1>
    <p class="text-lg text-mauve-700">
      This can't be undone.
    </p>
  </div>

  <div class="rounded-xl bg-mauve-950/[.025] p-6 mb-6">
    <p class="text-sm text-mauve-700 mb-3">Deleting your account permanently removes:</p>
    <ul class="text-sm text-mauve-700 space-y-1 list-disc list-inside">
      <li>your account and email address</li>
      <li>your Goodreads connection, if you made one</li>
      <li>any library you imported from a CSV export</li>
      <li>the record of which books you sent to BookMooch</li>
    </ul>
    <p class="text-sm text-mauve-700 mt-3">Your Goodreads and BookMooch accounts themselves are not affected.</p>
  </div>

  <% if flash['error'] %>
    <div class="bg-mauve-950/[.025] border border-mauve-300 text-mauve-950 px-4 py-3 rounded-xl mb-4">
      <p class="text-sm"><%= flash['error'] %></p>
    </div>
  <% end %>

  <form method="post" action="<%= rodauth.close_account_path %>" class="space-y-4">
    <%== csrf_tag(rodauth.close_account_path) %>

    <% if rodauth.close_account_requires_password? %>
      <div>
        <label for="password" class="block text-sm font-medium text-mauve-950 mb-2">Your password</label>
        <input type="password" id="password" name="<%= rodauth.password_param %>" autocomplete="current-password" required
               class="w-full px-4 py-3 border border-mauve-300 rounded-xl bg-white focus:ring-2 focus:ring-mauve-500 focus:border-mauve-500">
        <% if (error = rodauth.field_error(rodauth.password_param)) %>
          <p class="text-sm text-mauve-950 mt-2"><%= error %></p>
        <% end %>
      </div>
    <% end %>

    <div class="flex gap-3">
      <button type="submit" id="close-account-submit" class="flex-1 inline-flex items-center justify-center px-6 py-3 bg-mauve-950 text-white font-medium text-lg rounded-full hover:bg-mauve-900 transition-colors duration-200">
        Delete my account
      </button>

      <a href="/account" class="flex-1 inline-flex items-center justify-center px-6 py-3 bg-mauve-950/10 text-mauve-950 font-medium text-lg rounded-full hover:bg-mauve-950/20 transition-colors duration-200">
        Cancel
      </a>
    </div>
  </form>
</div>
