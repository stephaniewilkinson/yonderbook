<% content_for :title, "Find Your Library" %>
<% content_for :description, "Enter your zip code to find libraries near you. Search for free ebooks and audiobooks from your Goodreads list via Libby/OverDrive." %>

<div class="max-w-4xl mx-auto mb-8">
  <div class="text-center">
    <h3 class="font-display text-2xl font-medium text-mauve-950 mb-4">Step 2</h3>
    <div class="w-full bg-mauve-200 rounded-full h-2 mb-4">
      <div class="bg-mauve-950 h-2 rounded-full w-1/2"></div>
    </div>
    <h5 class="text-xl font-medium text-mauve-700">Find a library near you</h5>
  </div>
</div>

<div class="max-w-2xl mx-auto">
  <div class="rounded-xl bg-mauve-950/[.025] p-6">
    <%# Emitted for both actions, not just the anonymous one. Only
        POST /search/library calls check_csrf! today, but a token scoped to
        whichever action the form actually posts to costs one hidden input and
        means adding the check to POST /libraries cannot silently break it. %>
    <form action="<%= @library_action || '/libraries' %>" method="post" autocomplete="on">
      <%= csrf_tag(@library_action || '/libraries') %>
      <div class="mb-6">
        <label for="zipcode" class="block text-sm font-medium text-mauve-950 mb-2">Enter your zip code:</label>
        <input type="text"
               id="zipcode"
               name="zipcode"
               inputmode="numeric"
               autofocus
               autocomplete="postal-code"
               pattern="[0-9]{5}"
               maxlength="5"
               class="w-full px-3 py-2 border border-mauve-300 rounded-xl bg-white focus:ring-2 focus:ring-mauve-500 focus:border-mauve-500"
               placeholder="12345">
      </div>
      <button class="w-full inline-flex items-center justify-center px-6 py-3 bg-mauve-950 hover:bg-mauve-900 text-white font-medium text-lg rounded-full transition-colors duration-200"
              type="submit"
              name="action">
        <img src="/svg/location-marker.svg" alt="Location" class="w-5 h-5 mr-2">
        Find a library
      </button>

      <div class="mt-4 text-center">
        <button type="button"
                id="use-my-location"
                class="inline-flex items-center px-4 py-2 bg-mauve-950/10 hover:bg-mauve-950/20 text-mauve-950 text-sm font-medium rounded-full transition-colors duration-200">
          Or use my current location
        </button>
        <p id="location-status" class="text-sm text-mauve-700 mt-2 hidden"></p>
      </div>
    </form>
  </div>
</div>

<script>
  // Fills the zip field from the browser's location rather than replacing the
  // form: the user still sees which zip was chosen and can correct it before
  // submitting. Geolocation is unavailable on insecure origins and can be
  // denied, so the typed field always remains the primary path.
  (function () {
    const button = document.getElementById('use-my-location');
    const status = document.getElementById('location-status');
    const zipcode = document.getElementById('zipcode');
    if (!button || !navigator.geolocation) { return; }

    function show(message) {
      status.textContent = message;
      status.classList.remove('hidden');
    }

    button.addEventListener('click', function () {
      button.disabled = true;
      show('Finding your location...');

      navigator.geolocation.getCurrentPosition(function (position) {
        const query = new URLSearchParams({
          lat: position.coords.latitude,
          lon: position.coords.longitude
        });

        fetch('/nearest-zip?' + query)
          .then(function (response) { return response.json(); })
          .then(function (data) {
            button.disabled = false;
            if (!data.zip) {
              show('We could not match that to a US zip code. Please type one instead.');
              return;
            }
            zipcode.value = data.zip;
            show('Using ' + data.city + ', ' + data.state + ' (' + data.zip + '). Change it if that is wrong.');
          })
          .catch(function () {
            button.disabled = false;
            show('Something went wrong looking that up. Please type a zip code instead.');
          });
      }, function () {
        button.disabled = false;
        show('We could not get your location. Please type a zip code instead.');
      });
    });
  })();
</script>
