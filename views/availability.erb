<% content_for :robots, 'noindex' %>
<% content_for :title, "Library Availability" %>
<%# results_viewed: results with at least one book to borrow now, the step
    before borrow_clicked. results_empty: nothing to borrow now, so the two
    together give the hit rate. #1408, #1411 %>
<%# results_viewed_csv: the same moment for an imported library, so gtm.md's
    "share of results from CSV" can be read off. Fathom has no properties. %>
<% content_for :fathom_event, [@available_books.any? ? 'results_viewed' : 'results_empty',
                               ('results_viewed_csv' if @available_books.any? && imported_library?)].compact.join(' ') %>
<% content_for :description, "See which books from your Goodreads list are available at your library right now. Borrow free ebooks and audiobooks via Libby." %>

<%
  # Build summary lines for header
  summary_lines = [
    "There are #{@available_books.size} books available to check out right now.",
    "You can join the waiting list for #{@waitlist_books.size} books.",
    "#{@unavailable_books.size} books aren't owned by your library."
  ]

  header = {
    title: 'Finished!',
    summary_lines: summary_lines
  }

  # Shared search button SVG
  search_icon = '<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>'

  tabs = [
    {
      label: 'Available',
      title: 'Available Books',
      color: 'mauve',
      count: @available_books.size,
      empty_message: 'No books are currently available to check out.',
      books: @available_books.map do |book|
        {
          image: book.image,
          title: book.title,
          author: book.author,
          isbn: book.isbn,
          status_label: 'Available now',
          copies: copy_rows(book.copies.select { |copy| copy.copies_available.to_i.positive? })
        }
      end
    },
    {
      label: 'Waitlist',
      title: 'Join the waitlist',
      color: 'mauve',
      count: @waitlist_books.size,
      empty_message: 'No books are currently on the waitlist.',
      books: @waitlist_books.map do |book|
        {
          image: book.image,
          title: book.title,
          author: book.author,
          isbn: book.isbn,
          # Every waitlist copy, not just the best: joining two queues is a
          # real thing readers do, and it is the one case where a second
          # library changes what someone would do.
          status_label: 'Waitlist',
          copies: copy_rows(book.copies.select { |copy| copy.copies_owned.to_i.positive? }, action: :reserve)
        }
      end
    },
    {
      label: 'Unavailable',
      title: 'Not available at this library',
      color: 'mauve',
      count: @unavailable_books.size,
      empty_message: 'All books from your shelf are available or on the waitlist!',
      action_button: {url: @library_action || '/libraries', icon: '/svg/refresh.svg', label: 'Try a different library'},
      books: @unavailable_books.map do |book|
        {
          image: book.image,
          title: book.title,
          author: book.author,
          isbn: book.isbn,
          opacity: true,
          status_label: @library_names.size > 1 ? "Not owned by #{sentence(@library_names)}" : 'Not owned by library',
          button: {
            url: @library_url || AvailabilityHelpers::OVERDRIVE_HOME,
            icon_svg: search_icon,
            label: 'Search library',
            title: "Search your library for: #{book.title} by #{book.author}",
            class: 'bg-mauve-700 hover:bg-mauve-800'
          }
        }
      end
    }
  ]
%>

<%== render('_tabbed_availability_results', locals: {header: header, tabs: tabs}) %>

<% if @anonymous_search %>
  <%== partial 'anonymous_conversion' %>
<% else %>
  <%== partial 'alerts_panel' %>
<% end %>
