<% content_for :title, "Choose Your Library" %>
<% content_for :description, "Select your local library to search for free ebooks and audiobooks from your Goodreads list via Libby/OverDrive." %>

<div class="max-w-4xl mx-auto mb-8">
  <div class="text-center">
    <h3 class="font-display text-2xl font-medium text-mauve-950 mb-4">Step 3</h3>
    <div class="w-full bg-mauve-200 rounded-full h-2 mb-4">
      <div class="bg-mauve-950 h-2 rounded-full w-2/3"></div>
    </div>
    <h5 class="text-xl font-medium text-mauve-700">Choose your libraries</h5>
    <p class="text-sm text-mauve-600 mt-2">
      Pick up to <%= AvailabilityHelpers::MAX_LIBRARIES %>. Each one is searched separately, so more libraries means a longer wait.
    </p>
  </div>
</div>

<div class="max-w-2xl mx-auto">
  <form action="<%= @availability_action || "/goodreads/shelves/#{@shelf_name}/overdrive" %>" method="post" id="library-form">
    <% if @availability_action %><%= csrf_tag(@availability_action) %><% end %>
    <div class="space-y-4">
      <% @local_libraries.each_with_index do |library, index| %>
        <label class="block rounded-xl bg-mauve-950/[.025] overflow-hidden cursor-pointer has-[:checked]:ring-2 has-[:checked]:ring-mauve-950">
          <div class="flex items-center p-6">
            <div class="flex-shrink-0">
              <% if library[2] %>
                <img src="<%= library[2] %>" alt="<%= library[1] %>" class="w-16 h-10 rounded-lg object-contain bg-white">
              <% else %>
                <div class="w-12 h-12 bg-mauve-950/10 rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-mauve-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                </div>
              <% end %>
            </div>
            <div class="ml-4 flex-1">
              <h4 class="text-lg font-medium text-mauve-950"><%= library[1] %></h4>
            </div>
            <div class="ml-4">
              <input type="checkbox" name="consortium[]" value="<%= library[0] %>"
                     id="library-<%= library[0] %>"
                     <%= 'checked' if index.zero? %>
                     class="library-choice w-5 h-5 rounded border-mauve-950/30 text-mauve-950 focus:ring-mauve-950">
            </div>
          </div>
        </label>
      <% end %>
    </div>

    <p id="library-limit" class="hidden mt-4 text-sm text-rose-700">
      You can search up to <%= AvailabilityHelpers::MAX_LIBRARIES %> libraries at a time.
    </p>

    <button type="submit" name="action"
            class="mt-6 w-full inline-flex items-center justify-center px-6 py-3 bg-mauve-950 hover:bg-mauve-900 text-white font-medium rounded-full transition-colors duration-200">
      Check availability
    </button>
  </form>
</div>

<script>
  (function () {
    var max = <%= AvailabilityHelpers::MAX_LIBRARIES %>;
    var boxes = Array.prototype.slice.call(document.querySelectorAll('.library-choice'));
    var notice = document.getElementById('library-limit');
    var submit = document.querySelector('#library-form button[type="submit"]');
    if (!boxes.length) return;

    function sync() {
      var chosen = boxes.filter(function (box) { return box.checked; }).length;
      notice.classList.toggle('hidden', chosen <= max);
      boxes.forEach(function (box) { box.disabled = !box.checked && chosen >= max; });
      submit.disabled = chosen === 0;
      submit.classList.toggle('opacity-50', chosen === 0);
    }

    boxes.forEach(function (box) { box.addEventListener('change', sync); });
    sync();
  })();
</script>
